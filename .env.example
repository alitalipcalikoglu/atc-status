# --- Server ---
PORT=3018
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=16384

# --- Storage ---
DB_PATH=./data/status.db
DB_BACKUP_DIR=
CHECK_RETENTION_DAYS=14
INCIDENT_RETENTION_DAYS=365

# --- Callers: id:secret:role, comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: read (monitors, checks, incidents, stats, metrics), admin (also create, change, check now, delete).
STATUS_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS:admin
RATE_LIMIT_MAX=600

# --- Seeded monitors: id=baseUrl, comma separated. Each becomes <id>-health and <id>-ready (public, every SEED_INTERVAL_SEC).
# Operator configuration: these may be private addresses.
MONITOR_SEEDS=atc-auth=http://127.0.0.1:3002,atc-media=http://127.0.0.1:3003
SEED_INTERVAL_SEC=60

# --- Monitors created through the API pass this SSRF guard (https only, public addresses, by default).
TARGET_ALLOW_HTTP=false
# true also needs TARGET_ALLOWED_HOSTS (exact host or parent domain).
TARGET_ALLOW_PRIVATE=false
TARGET_ALLOWED_HOSTS=

# --- Check loop ---
MAX_MONITORS=500
# Checks running at the same time.
MAX_CONCURRENT=8
TICK_MS=1000

# --- Public status page (GET /status, GET /status/summary.json) ---
STATUS_PAGE_TITLE=Service status
STATUS_PAGE_CACHE_SEC=15

# --- Alerts (optional): e-mail when an incident opens and closes, through atc-notify's generic template. Both or neither.
NOTIFY_URL=
NOTIFY_API_KEY=
# Required with NOTIFY_URL.
# At most 10 addresses (atc-notify limit per message).
ALERT_EMAILS=
ALERT_APP_NAME=atc-web
NOTIFY_TIMEOUT_MS=10000

# --- Audit (optional): forward monitor changes to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-status:…:write
AUDIT_URL=
AUDIT_API_KEY=
